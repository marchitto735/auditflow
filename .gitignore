node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.*

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Optional npm / eslint / stylelint caches
.npm
.eslintcache
.stylelintcache
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn & pnpm files
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store

# Environment variables (Crucial: keeps your .env.local hidden)
.env
.env.*
!.env.example

# Next.js build output
.next
out

# Vercel
.vercel

