      "parameters": {
        "jsCode": "// Combine all reference sections into one formatted string\nconst sections = $input.all().map(item => item.json);\n\n// Sort by section_number and join text\nconst fullBenchmarkText = sections\n  .sort((a, b) => (a.section_number || 0) - (b.section_number || 0))\n  .map(sec => `Section ${sec.section_number || ''}: ${sec.title || 'Untitled'}\\n${sec.content || ''}`)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    golden_sop_text: fullBenchmarkText\n  }\n}];"
      },
