    {
      "parameters": {
        "jsCode": "const outputItem = $input.first().json;\n// If the previous node outputted directly or nested, let's grab the text payload:\nconst textContent = outputItem.output?.content?.[0]?.text || outputItem.text || {};\n\nlet activeClauseId = 27;\ntry {\n  if (typeof $ !== 'undefined' && $(\"Get Clause Rule\")?.length) {\n    activeClauseId = $(\"Get Clause Rule\").first().json.clause_id || $(\"Get Clause Rule\").first().json.id || 27;\n  }\n} catch (e) {}\n\nreturn [{\n  json: {\n    score: textContent.score || 70,\n    status: textContent.status || \"Partially Compliant\",\n    gaps: textContent.gaps || [],\n    discrepancies: textContent.gaps || [],\n    summary: textContent.summary || \"Audit completed with findings.\",\n    recommendation: textContent.recommendation || textContent.recommendations || null,\n    clause_id: activeClauseId,\n    sop_id: null,\n    ingestion_id: null\n  }\n}];"
      },
