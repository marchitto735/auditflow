    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (!item.binary) continue;\n\n  for (const key of Object.keys(item.binary)) {\n    const file = item.binary[key];\n    const fileName = (file.fileName || '').toLowerCase();\n    const mime = (file.mimeType || '').toLowerCase();\n\n    // 1. Repair PDFs\n    if (mime.includes('octet-stream') && fileName.endsWith('.pdf')) {\n      file.mimeType = 'application/pdf';\n      file.fileExtension = 'pdf';\n    } \n    \n    // 2. Repair JPEGs\n    else if (mime.includes('octet-stream') && (fileName.endsWith('.jpg') || fileName.endsWith('.jpeg'))) {\n      file.mimeType = 'image/jpeg';\n      file.fileExtension = 'jpg';\n    } \n    \n    // 3. Repair PNGs\n    else if (mime.includes('octet-stream') && fileName.endsWith('.png')) {\n      file.mimeType = 'image/png';\n      file.fileExtension = 'png';\n    }\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        -160
      ],
      "id": "838d66ef-e915-4669-86f5-1d58b8eef17f",
      "name": "Format Ingestion Payload"
    },
    {
      "parameters": {
        "jsCode": "// 1. Get the raw text from the OpenAI vision model output\n// Based on your screenshot, it's located in the output array's content text\nlet rawText = $input.first().json.output[0].content[0].text;\n\n// 2. Clean up markdown formatting (OpenAI often wraps JSON in ```json ... ```)\nrawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// 3. Parse the cleaned text into a real JavaScript object\nlet parsedData = {};\ntry {\n  parsedData = JSON.parse(rawText);\n} catch (error) {\n  console.log(\"Error parsing JSON:\", error);\n}\n\n// 4. Point to the 'checklist' object based on your OpenAI output structure\nconst checklist = parsedData.checklist || {};\n\n// 5. Map the fields and return the clean object for Supabase\nreturn {\n  json: {\n    // Generate a fallback ID using the current timestamp if one doesn't exist\n    fir_id: checklist.fir_id ? parseInt(checklist.fir_id, 10) : Date.now(),\n    \n    // Map the exact keys extracted by the vision model\n    title: checklist.document_ref || \"FIR-DEFAULT\",\n    asset_tag_id: checklist.asset_tag_id || \"UNKNOWN\",\n    inspector_name: checklist.lead_inspector || \"Unassigned\",\n    location_zone: checklist.facility || \"General\",\n    inspection_date: checklist.date || new Date().toISOString().split('T')[0],\n    operational_status: checklist.operational_status || \"PENDING\",\n    \n    // Store the findings/defects if present\n    defects_found: checklist.audit_evaluation ? JSON.stringify(checklist.audit_evaluation) : null,\n    \n    // Store the full raw JSON safely in case you need it later\n    raw_extracted_json: parsedData\n  }\n};"
      },
