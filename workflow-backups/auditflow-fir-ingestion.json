      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length) {\n  throw new Error(\"No input received from Extract from File node.\");\n}\n\nconst item = items[0].json;\n\n// Check all common n8n file extraction key variants\nlet rawText = \n  item.text || \n  item.text_0 || \n  item.data || \n  item.text_content || \n  item.content || \n  item.extractedText || \n  (item.binary && item.binary.data ? item.binary.data : \"\") || \n  \"\";\n\n// Convert double quotes to single quotes & sanitize backslashes/newlines\nconst sanitizedText = String(rawText)\n  .replace(/\"/g, \"'\")\n  .replace(/\\\\/g, \"/\")\n  .replace(/[\\r\\n]+/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nreturn [{\n  json: {\n    text: sanitizedText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
