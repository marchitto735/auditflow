# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# --- OpenAI (chat + embeddings + RAG) ---
OPENAI_API_KEY=
# Chat model for /api/chat (OpenAI Chat Completions)
MODEL_NAME=gpt-4.1-mini

# --- ChatKit ---
# OpenAI-hosted workflow when custom URL below is unset:
WORKFLOW_ID=

# Custom backend: set to /api/chat for RAG (resume + knowledge/). Restart dev after changing.
NEXT_PUBLIC_CHATKIT_CUSTOM_API_URL=

# ChatKit domain key from OpenAI (required when using custom api.url, e.g. /api/chat)
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=

# --- Supabase (browser client + server ingestion) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for /api/audit/run and ingestion writes.
# Supabase → Project Settings → API → service_role (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: send /api/audit/run to local n8n instead of the native TypeScript pipeline.
# AUDIT_USE_N8N=true

# Local n8n webhooks (only used when AUDIT_USE_N8N=true). Restart `npm run dev` after changes.
# SOP: http://localhost:5678/webhook/auditflow/upload
# BPR: http://localhost:5678/webhook/76dabb5f-1c5c-4dcc-9537-86327a05ad9f
# FIR: http://localhost:5678/webhook/eda02a12-3985-4259-9339-48a5f4731a9e
NEXT_PUBLIC_N8N_SOP_INGESTION_URL=http://localhost:5678/webhook/auditflow/upload
NEXT_PUBLIC_N8N_BPR_INGESTION_URL=http://localhost:5678/webhook/76dabb5f-1c5c-4dcc-9537-86327a05ad9f
NEXT_PUBLIC_N8N_FIR_INGESTION_URL=http://localhost:5678/webhook/eda02a12-3985-4259-9339-48a5f4731a9e
N8N_WORKFLOW_ONE_URL=

# Cal.com scheduling (optional; API v2 — see lib/cal-api.ts)
# CAL_API_KEY=
# CAL_API_URL=https://api.cal.com
# CAL_EVENT_TYPE_ID=
